rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /teams/{teamId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /results/{resultId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /penalties/{penaltyId} {
      allow read, write: if request.auth != null;
    }
  }
}
